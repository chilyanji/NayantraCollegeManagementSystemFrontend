# Vite development proxy target. Use the machine running FastAPI.
SENTINEL_BACKEND_URL=http://127.0.0.1:8000
# Browser-facing API base. /api uses the same-origin development/reverse proxy.
VITE_API_URL=/api
# Preserve PyQt admin auto-start behavior. Disable for manual-only start.
VITE_AUTO_START_AI=true
# Optional historical endpoints from the React references; blank because PyQt helpers are stubs.
VITE_ACTIVITY_PATH=
VITE_EVENTS_PATH=
